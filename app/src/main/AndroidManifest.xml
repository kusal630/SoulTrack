<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Ambient noise sensing for the focus estimator. Audio is never recorded or stored. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".SoulTrackApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyTrack">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DailyTrack.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TimerForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="time_tracking" />
        </service>

        <service
            android:name=".service.PomodoroForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pomodoro_timer" />
        </service>

        <receiver
            android:name=".widget.TimerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="io.github.dailytrack.ACTION_WIDGET_START" />
                <action android:name="io.github.dailytrack.ACTION_WIDGET_STOP" />
                <action android:name="io.github.dailytrack.ACTION_WIDGET_RESET" />
                <action android:name="io.github.dailytrack.ACTION_WIDGET_UPDATE" />
                <action android:name="io.github.dailytrack.ACTION_CYCLE_CATEGORY" />
                <action android:name="io.github.dailytrack.ACTION_NEXT_QUOTE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_timer_info" />
        </receiver>

        <receiver
            android:name=".widget.QuoteWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="io.github.dailytrack.ACTION_QUOTE_WIDGET_NEXT" />
                <action android:name="io.github.dailytrack.ACTION_QUOTE_WIDGET_SAVE" />
                <action android:name="io.github.dailytrack.ACTION_QUOTE_WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quote_info" />
        </receiver>

        <receiver
            android:name=".widget.PomodoroWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="io.github.dailytrack.ACTION_POM_WIDGET_START" />
                <action android:name="io.github.dailytrack.ACTION_POM_WIDGET_STOP" />
                <action android:name="io.github.dailytrack.ACTION_POM_WIDGET_RESET" />
                <action android:name="io.github.dailytrack.ACTION_POM_WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pomodoro_info" />
        </receiver>

    </application>

</manifest>
